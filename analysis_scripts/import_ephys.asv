%% Wrapper for importing ephys and performing processing steps

spaths       = {'D:\Data\Kelton\analyses\ZM020\ZM020_02232026_rec_D1_RLat1',...
    'D:\Data\Kelton\analyses\KW087\KW087_02082026_rec_D2_RLat2',...
    'D:\Data\Kelton\analyses\KW091\KW091_03192026_rec_D4_LLat2',...
    'D:\Data\Kelton\analyses\ZM035\ZM035_06112026_rec_D1_LLat1',...
    'D:\Data\Kelton\analyses\ZM032\ZM032_05282026_rec_D1_RLat1',...
    'D:\Data\Kelton\analyses\ZM012\ZM012_12192025_rec_D2_RMed1',...
    'D:\Data\Kelton\analyses\ZM006\ZM006_10172025_rec_D4_LLat2',...
    'D:\Data\Kelton\analyses\KW101\KW101_05262026_rec_D1_RLat1',...
    'D:\Data\Kelton\analyses\KW100\KW100_05202026_rec_D4_LLat2',...
    'D:\Data\Kelton\analyses\KW099\KW099_05062026_rec_D2_RLat2',...
    'D:\Data\Kelton\analyses\KW097\KW097_05052026_rec_D4_LLat1',...
    'D:\Data\Kelton\analyses\KW082\KW082_12092025_rec_D3_LLat1',...
    'D:\Data\Kelton\analyses\KW079\KW079_11112025_rec_D2_RLat2',...
    'D:\Data\Kelton\analyses\KW077\KW077_11262025_rec_D2_RLat2',...
    'D:\Data\Kelton\analyses\KW073\KW073_10132025_rec_D1_RLat1',...
    'D:\Data\Kelton\analyses\KW080\KW080_11252025_rec_D1_RLat1',...
    'D:\Data\Kelton\analyses\ZM029\ZM029_05112026_rec_D3_LLat1'};
datpaths     = {'D:\Data\Kelton\probe_data\ZM020\ZM020_02232026_rec_D1_RLat1_g0',...
        'D:\Data\Kelton\probe_data\KW087\KW087_02082026_rec_D2_RLat2',...
    'D:\Data\Kelton\probe_data\KW091\KW091_03192026_rec_D4_LLat2',...
    'D:\Data\Kelton\probe_data\ZM035\ZM035_06112026_rec_D1_LLat1',...
    'D:\Data\Kelton\probe_data\ZM032\ZM032_05282026_rec_D1_RLat1',...
    'D:\Data\Kelton\probe_data\ZM012\ZM012_12192025_rec_D2_RMed1',...
    'D:\Data\Kelton\probe_data\ZM006\ZM006_10172025_rec_D4_LLat2',...
    'D:\Data\Kelton\probe_data\KW101\KW101_05262026_rec_D1_RLat1',...
    'D:\Data\Kelton\probe_data\KW100\KW100_05202026_rec_D4_LLat2',...
    'D:\Data\Kelton\probe_data\KW099\KW099_05062026_rec_D2_RLat2',...
    'D:\Data\Kelton\probe_data\KW097\KW097_05052026_rec_D4_LLat1',...
    'D:\Data\Kelton\probe_data\KW082\KW082_12092025_rec_D3_LLat1',...
    'D:\Data\Kelton\probe_data\KW079\KW079_11112025_rec_D2_RLat2',...
    'D:\Data\Kelton\probe_data\KW077\KW077_11262025_rec_D2_RLat2',...
    'D:\Data\Kelton\probe_data\KW073\KW073_10132025_rec_D1_RLat1',...
    'D:\Data\Kelton\probe_data\KW080\KW080_11252025_rec_D1_RLat1',...
    'D:\Data\Kelton\probe_data\ZM029\ZM029_05112026_rec_D3_LLat1'};

region       = [1,1,1]; % 1 = CA1 or Sub; 2 = EC
ovrwrtSess   = 0;
ovrwrtRoot   = 0;
ovrwrtDatS   = 0;
splitType    = [1,1,1];       % 0 = no split; 1 = RZ shift; 2 = RZ Rand
splitLap     = [];
% ripRef       = [];
saveFlag     = true;
doMakeSess   = false;
doMakeRoot   = false;
doDepthPlots = false;
doSpikeXSess = false;
doLFPxDepth  = false;
lfpBands     = [6 10; 150 250];
doBursts     = false;
doUnitType   = false;
doAssignLyr  = false;
doCountSum   = false;
doRipples    = false;
doSplitLFP   = false;
doPhysSum    = true;
doUnitParams = false;
doShuffles   = false;
nShuf        = 250;

%% Start loop

for j = 1:length(spaths)
    spath = spaths{j};
    datpath = datpaths{j};

    strs = split(spath,'\');
    disp(['Processing ephys for ' strs{end}])

    %% Load existing root file

    clear root sess
    cd(spath)

    try
        sessfile = dir("*_session.mat");
        load(sessfile.name)
        sessMade = true;
    catch
        sessMade = false;
        disp('Failed to import session')
    end

    try
        rootfile = dir("*_root.mat");
        load(rootfile.name)
        rootMade = true;
    catch
        rootMade = false;
        disp('Failed to import root')
    end

    if sessMade & ~ovrwrtSess
        disp(['Loaded session for ' strs{end}])
    else
        %% Create Sess and remove non operant laps
        try
            if doMakeSess
                sess = importBhvr(spath);
                nonops = get_nonOpLaps(sess);
                sess = get_errorTrials(sess,nonops);
                sess = get_lapInclude(sess);
                [~,sess.velXpos] = plot_trialvel(sess,0.01,0);
                [~,sess.velXrwd] = get_velXrwd(sess,0.25,5,0);

                save([sess.name(1:14), '_session'], 'sess','-v7.3')
                disp(['Session made and saved'])
            end
        catch
            warning('Failed to create sess')
        end
    end

    if rootMade & ~ovrwrtRoot
        disp(['Loaded root for ' strs{end}])

    else
        %% Create root
        try
            if doMakeRoot
                loadKS(datpath,spath,1);    % With overwrite set to 1
                root = alignBhvrTS(spath,spath,spath);
                disp(['Root made and TS aligned for ' strs{end}])
                rm_phy_files(datpath);
            end
        catch
            warning('Failed to create root')
        end

        %% Plot Amp X Depth x FR
        try
            if doDepthPlots
                adfrFig = plot_ampXdepthxFR(root);
                frdFig = plot_datXdepth(root,0,1,0,0);

                if saveFlag
                    saveas(adfrFig,[root.name '_AmpDepthFR_all.png'])
                    saveas(frdFig,[root.name '_FRDepth_good.png'])
                end
                disp('Made depth plots')
            end
        catch
            warning('Failed to make depth plots')
        end

        %% Summarize spike counts across session
        try
            if doSpikeXSess
                tmpSpikeDensityFig = plot_spikeDensity(root,60);
                if saveFlag; saveas(tmpSpikeDensityFig,[root.name '_spikeDensity.png']); end

                disp('Made spike density plots')
            end
        catch
            warning('Failed to summarize spike density plots')
        end

        %% Estimate LFP power by depth
        try
            if doLFPxDepth
                root = get_lfpXdepth(root,lfpBands);
                if region(j) == 1
                    root = get_lyrBounds_hpc(root,100,0.25);    % Assign layer boundaries, min layer width 100um, prominence cut off 0.25
                elseif region(j) == 2
                    [root,tmpDat] = get_lyrBounds_ec(root,sess);    % Assign layer boundaries and units to layers
                end
                lfpPowerFig = plot_lfpXdepth(root);
                if saveFlag; saveas(lfpPowerFig,[root.name '_LFPPower.png']); end

                disp('Calculated LFP power by bands and set layers')
            end
        catch
            warning('Failed to calculate LFP by depth and set layers')
        end

        %% Add bursts to root
        try
            if doBursts
                root = burst2root(root,sess);
                disp('Added bursts to root')
            end
        catch
            warning('Failed to add bursts to root')
        end

        %% Assign putative unit type (0 = IN; 1 = Principle) and FR Variance by time
        try
            if doUnitType
                [root, INsFig] = get_estCellType(root,0.5,0.4,100,1);    % FW = 15; FWHM = 5; FR = 100; Plotflag = 1
                % [root, INsFig] = get_umapCellType(root,1);

                if saveFlag; saveas(INsFig,[root.name '_FW_class.png']); end

                disp('Assigned unit types')
            end
        catch
            warning('Failed to assign unit types')
        end

        %% Assign and plot units by layer and type
        try
            if doAssignLyr
                if region(j) == 1
                    root = get_layerUnits(root);

                    uTypeDepthFig = plot_layerUnits(root,1,0,0);
                    if saveFlag; saveas(uTypeDepthFig,[root.name '_uTypeXDepth.png']); end

                elseif region(j) == 2
                    tmpD = root.info.depth(root.goodind);

                    uTypeDepthFig = plot_layerUnits(root,1,0,0);

                    thDepthFig = plot_datXdepth(root,tmpDat,1,0,0,2); % theta
                    plot(tmpDat.thAng(tmpDat.lyrID == 5)+180, tmpD(tmpDat.lyrID == 5),'k*')
                    plot(tmpDat.thAng(tmpDat.lyrID == 3)+180, tmpD(tmpDat.lyrID == 3),'c*')
                    plot(tmpDat.thAng(tmpDat.lyrID == 2)+180, tmpD(tmpDat.lyrID == 2),'m*')
                    legend('off'); % legend('Data','EC5','EC3','EC2')
                    set(gcf,'units','normalized','position',[0.4 0.2 0.15 0.6]);
                    thDepthFig = fixRatio(thDepthFig);

                    if sum(isnan(tmpDat.optoPkT)) ~= length(root.good) % If some opto peaks
                        opDepthFig = plot_datXdepth(root,tmpDat,1,0,0,4); % Opto flag
                        plot(tmpDat.optoPkT(tmpDat.lyrID == 5)*1000, tmpD(tmpDat.lyrID == 5),'k*')
                        plot(tmpDat.optoPkT(tmpDat.lyrID == 3)*1000, tmpD(tmpDat.lyrID == 3),'c*')
                        plot(tmpDat.optoPkT(tmpDat.lyrID == 2)*1000, tmpD(tmpDat.lyrID == 2),'m*')
                        set(gcf,'units','normalized','position',[0.4 0.2 0.15 0.6]);
                        opDepthFig = fixRatio(opDepthFig);
                        if saveFlag
                            saveas(opDepthFig,[root.name '_opXdepthXlyr.png'])
                        end
                    end

                    if saveFlag
                        saveas(uTypeDepthFig,[root.name '_uTypeXDepth.png'])
                        saveas(thDepthFig,[root.name '_thXdepthXlyr.png'])
                    end
                end

                disp('Assigned units to layers')
            end
        catch
            warning('Failed to assign units to layers and plot')
        end

        %% Summarize counts by shank and depth
        try
            if doCountSum
                [depthCountFig, shankCountFig] = plot_count_shank(root,region(j));

                if saveFlag
                    saveas(depthCountFig,[root.name '_count_good.png'])
                    saveas(shankCountFig,[root.name '_shankCount_good.png'])
                end
                disp('Plotted good units by shank and depth')
            end
        catch
            warning('Failed to summarize counts by shank and depth')
        end

        %% Get ripples
        try
            if doRipples
                chans = root.uPSDMax(2,:);
                for i = 1:length(chans)
                    ripStruc(i).ripples = get_ripples(root,chans(i),sess,3,5,[15 250]);
                end
                root.ripStruc = ripStruc;

                if root.prbType == 'NPX1.0'
                    root.ripRef = 1;
                else
                    root.ripRef = 0;    % Place holder that will error if not manually corrected
                end

                disp(['Found ripples and assigned ripRef to shank ' num2str(root.ripRef-1)])
            end
        catch
            warning('Failed to get SPWRs and assign ripRef')
        end

        %% Split out LFP to improve subsequent root save/load speed
        try
            if doSplitLFP
                [root, lfp] = rmRootLFP(root);

                save([lfp.name '_lfp'],'lfp','-v7.3')

                disp('Split LFP out to separate file')
            end
        catch
            warning('Failed to save LFP separately')
        end

        %% Save updated root
        try
            saveRoot(root,spath)
            disp('Saved updated root')
        catch
            warning('Failed to save updated root')
        end

        %% Plot phys compact
        close all

        try
            if doPhysSum
                plotPhysCompact(root,sess,spath,1)

                disp(['Finished phys summary for ' root.name])
            end
        catch
            warning('Failed to make individual unit plots')
        end

    %% Proceed to making a data struct
    try
        datfile = dir("*_dat.mat");
        load(datfile.name)
        datMade = true;
    catch
        datMade = false;
        disp('Failed to load data struct')
    end

    if datMade & ~ovrwrtDatS
        disp(['Loaded dat for ' strs{end}])

    else
        %% Get Real Unit parameters

        if isempty(splitLap) % Split Rec at default location in splitRec
            splitLap = zeros(length(region),1);
        end

        try
            if doUnitParams
                if splitType(j) == 0
                    datStruc = get_unitParams(root,root.good,sess,[],true,true,true,doRipples,false,0,false);
                end

                if splitType(j) > 0
                    [sessFrst, sessLast, rootFrst, rootLast] = splitRec(sess,root,splitLap(j));
                    % rwdShift = find(diff(sess.pos(sess.rwdind)) > 0.4,1);   % Find lap of reward shift
                    % rwdShift = sess.rwdTrials(rwdShift);
                    % 
                    % frstHalfInds         = [sess.ind(1) sess.lapend(rwdShift)];
                    % lastHalfInds         = [sess.lapstt(rwdShift+1) sess.ind(end)];
                    % [sessFrst, rootFrst] = epochStruc(sess,root,frstHalfInds);
                    % [sessLast, rootLast] = epochStruc(sess,root,lastHalfInds);
                end 

                if splitType(j) == 1
                    frstHalf = get_unitParams(rootFrst,root.good,sessFrst,[],true,true,true,doRipples,false,0,false);
                    lastHalf = get_unitParams(rootLast,root.good,sessLast,[],true,true,true,doRipples,false,0,false);
                elseif splitType(j) == 2
                    sessFrst = get_QTwin(sessFrst,sessFrst.rwdind);
                    sessLast = get_QTwin(sessLast,sessLast.rwdind);

                    qfrst.q = sessFrst.qInd;
                    qfrst.stt = sessFrst.qStt;
                    qfrst.end = sessFrst.qEnd;
                    qfrst.qID = sessFrst.qTrialID;
                    qlast.q = sessLast.qInd;
                    qlast.stt = sessLast.qStt;
                    qlast.end = sessLast.qEnd;
                    qlast.qID = sessLast.qTrialID;

                    frstHalf = get_unitParams(rootFrst,root.good,sessFrst,[],true,true,true,doRipples,true,qfrst,false);
                    lastHalf = get_unitParams(rootLast,root.good,sessLast,[],true,true,true,doRipples,true,qlast,false);
                end
            end

            disp('Created data structure and calculated unit parameters')
        catch
            warning('Failed to calculate real unit parameters')
        end

        %% Get shuffle unit parameters
        try
            if doShuffles
                if splitType(j) == 0
                    datStruc = get_shufParams(root,root.good,sess,datStruc,nShuf);
                end

                if splitType(j) == 1
                    frstHalf = get_shufParams(rootFrst,root.good,sessFrst,frstHalf,nShuf,true,true);
                    lastHalf = get_shufParams(rootLast,root.good,sessLast,lastHalf,nShuf,true,true);
                elseif splitType(j) == 2
                    frstHalf = get_shufParams(rootFrst,root.good,sessFrst,frstHalf,nShuf,true,false,true,qfrst);
                    lastHalf = get_shufParams(rootLast,root.good,sessLast,lastHalf,nShuf,true,false,true,qlast);
                end
            end

            disp('Ran shuffles')
        catch
            warning('Failed to do shuffles')
        end

        %% Save dat strucs
        try
            if splitType(j) == 0
                save([root.name '_dat'],'datStruc')
            else
                save([root.name '_datRemade'],'frstHalf','lastHalf','rootFrst','rootLast','sessFrst','sessLast')
            end

            disp('Saved data structure')
        catch
            warning('Failed to save data structure')
        end

    end

%% End processing
disp(['Done processing ephys for ' strs{end}])

end